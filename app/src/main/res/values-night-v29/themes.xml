<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Máy để giao diện tối: báo cho WebView (isLightTheme=false) để Zalo Web thấy prefers-color-scheme: dark và tự
        chuyển tối khi chọn "Theo hệ thống". Phần còn lại giữ như AppTheme sáng; màu thanh hệ thống do MainActivity tô
        theo trang.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/zalo_blue</item>
        <item name="android:colorAccent">@color/zalo_blue</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:isLightTheme">false</item>
    </style>
</resources>
